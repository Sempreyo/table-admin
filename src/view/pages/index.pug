extends ../layouts/default

block vars
	-
		const page = {
			title: 'Table-admin'
		};

block main
	section.table
		.container
			.table__sticky-menu
				.table__create
					label Количество строк
						input.table__num-rows(type='number', min='1')
					label Количество столбцов
						input.table__num-columns(type='number', min='1')
					button.btn.btn-primary.btn-small.js-create-table Добавить
				.table__panel(hidden)
					.table__panel-group
						button.btn.btn-primary.btn-small.js-edit(data-edit='bold')
							i.icon-bold.icon-white
						button.btn.btn-primary.btn-small.js-edit(data-edit='italic')
							i.icon-italic.icon-white
						button.btn.btn-primary.btn-small.js-edit(data-edit='horizontal-left')
							i.icon-align-left.icon-white
						button.btn.btn-primary.btn-small.js-edit(data-edit='horizontal-center')
							i.icon-align-center.icon-white
						button.btn.btn-primary.btn-small.js-edit(data-edit='horizontal-right')
							i.icon-align-right.icon-white
						button.btn.btn-primary.btn-small.js-edit(data-edit='remove-edit')
							i.icon-remove.icon-white
						.table__button-with-dropdown
							button.btn.btn-primary.btn-small(data-dropdown='link')
								span Ссылка
							form.table__dropdown(hidden)
								input(type='text', name='link-text', placeholder='Текст')
								input(type='text', name='link', placeholder='Ссылка')
								label.checkbox
									input(type='checkbox', name='link-target')
									p
										i.icon-ok
									span В новом окне?
								button.btn.btn-primary.btn-small(type='submit') Добавить
						.table__button-with-dropdown
							button.btn.btn-primary.btn-small(data-dropdown='color')
								i.icon-tint.icon-white
								span Цвет ячейки
							form.table__dropdown
								input(type='color', name='color', value='#ffffff')
								span Применить к
								label.radio
									input(type='radio', name='apply-to', value='cell', checked)
									p
										i.icon-ok
									span Выделенной ячейке
								label.radio
									input(type='radio', name='apply-to', value='row')
									p
										i.icon-ok
									span Строке
								label.radio
									input(type='radio', name='apply-to', value='column')
									p
										i.icon-ok
									span Столбцу
								button.btn.btn-primary.btn-small(type='submit') Добавить
						.table__button-with-dropdown
							button.btn.btn-primary.btn-small(data-dropdown='width')
								i.icon-resize-horizontal.icon-white
								span Ширина столбца
							form.table__dropdown
								input(type='text', name='width', placeholder='Ширина в px')
								button.btn.btn-primary.btn-small(type='submit') Добавить
					.table__panel-group
						button.btn.btn-primary.btn-small.js-create-row
							i.icon-plus-sign.icon-white
							span Строка
						button.btn.btn-primary.btn-small.js-create-column
							i.icon-plus-sign.icon-white
							span Столбец
					.table__panel-group
						button.btn.btn-primary.btn-small.js-remove-row
							i.icon-trash.icon-white
							span Удалить строку
						button.btn.btn-primary.btn-small.js-remove-column
							i.icon-trash.icon-white
							span Удалить столбец
					.table__panel-group
						button.btn.btn-primary.btn-small.js-join-cells
							i.icon-resize-small.icon-white
							span Объединить
						button.btn.btn-primary.btn-small.js-split-cells
							i.icon-resize-full.icon-white
							span Разделить
					.table__panel-group
						label.btn.btn-primary.btn-small
							i.icon-upload.icon-white
							span Импорт
							input.js-import(type='file', accept='.csv,.xlsx,.xls')
							span.error-msg(hidden)
						button.btn.btn-primary.btn-small.js-export
							i.icon-download.icon-white
							span Экспорт
			.table__wrapper
